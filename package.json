{
  "name": "followup",
  "productName": "FollowUp",
  "version": "0.1.1",
  "description": "Follow-up WhatsApp per le fatture Wincar",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "it.followup.app",
    "productName": "FollowUp",
    "files": [
      "*.js",
      "preload.cjs",
      "index.html",
      "style.css",
      "assets/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gabrielesarria167-ai",
        "repo": "followUp"
      }
    ]
  },
  "dependencies": {
    "mdb-reader": "^3.2.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "type": "module"
}
