{
  "name": "followup",
  "productName": "FollowUp",
  "version": "0.6.5",
  "description": "FollowUp",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis --x64",
    "icons": "electron scripts/render-icon.cjs assets/icon.svg assets/icon.png build/icon.ico"
  },
  "build": {
    "appId": "it.followup.app",
    "productName": "FollowUp",
    "files": [
      "*.js",
      "preload.cjs",
      "index.html",
      "style.css",
      "assets/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gabrielesarria167-ai",
        "repo": "followUp"
      }
    ]
  },
  "dependencies": {
    "mdb-reader": "^3.2.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "type": "module"
}
